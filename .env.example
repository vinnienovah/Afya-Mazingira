# ─── AFYA HEWA Environment Variables ─────────────────────────────────────────
# Copy to .env and fill in real values. The app runs in DEMO MODE when absent.

# Conduit (leave blank for demo mode)
CONDUIT_URL=https://conduit.jhubafrica.com/data.php
CONDUIT_API_KEY=
CONDUIT_EMAIL=

# Database (provided by platform in production; for local dev, point this at
# a local Postgres — e.g. `brew install postgresql@16` then create a role/db
# and run `npm run db:push` to create the schema)
DATABASE_URL=

# Google OAuth (Sign in with Google) — create credentials at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Copernicus Data Space (leave blank for demo mode)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# CDS API (ERA5-Land)
CDS_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# LLM communication layer (server-side only)
# Provider order: Gemini → OpenAI → deterministic EN/SW fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional legacy Anthropic provider
LLM_API_KEY=

# Web Push (VAPID — leave blank for demo-safe notification simulation)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:afya@afyahewa.dev

# App
APP_ENV=development
APP_TIMEZONE=Africa/Nairobi
NEXT_PUBLIC_APP_URL=http://localhost:3000
