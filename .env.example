# Afya Mazingira environment variables. Copy to .env and fill in what you have.
# Every one is optional: without them the app uses the public CHORDS feed and
# the committed archive for station data, and simple fallbacks elsewhere.

# Conduit API from JHUB (leave the key and email blank to use CHORDS and the archive)
CONDUIT_URL=https://conduit.jhubafrica.com/data.php
CONDUIT_API_KEY=
CONDUIT_EMAIL=
# The same station's public live feed on the CHORDS portal. No key needed.
CHORDS_LIVE_URL=https://3d-fewsnet.icdp.ucar.edu/instruments/61/live
# Recorded archive used when no live feed answers. See data/README.md.
# Defaults to data/conduit_master_2025_2026.csv.
CONDUIT_CSV_PATH=

# Database. Vercel's Neon integration sets this in production. Locally, point
# it at a Postgres database and run `npm run db:push` to create the tables.
DATABASE_URL=

# Sign in with Google: create credentials at
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend, for sign-up verification links and daily alert emails.
# https://resend.com/api-keys. Mail reaches other people only from a domain
# verified at https://resend.com/domains. Blank: new accounts are verified at once.
RESEND_API_KEY=
RESEND_FROM_EMAIL="AFYA MAZINGIRA <onboarding@resend.dev>"

# Daily alert job (vercel.json). Required: without it the endpoint refuses
# every request. Any long random string; Vercel sends it on scheduled runs.
CRON_SECRET=

# Copernicus Data Space, for Sentinel-2 NDVI and acquisition dates
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Language model explanations, tried in this order: Gemini, Groq, OpenAI,
# Anthropic, then the written English and Kiswahili templates.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Anthropic
LLM_API_KEY=

# Web push. Blank: notifications are simulated in the page.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: address or https URL the push services can contact
VAPID_EMAIL=

# Public address of the app, for sitemap, OAuth redirects and email links
NEXT_PUBLIC_APP_URL=http://localhost:3000
